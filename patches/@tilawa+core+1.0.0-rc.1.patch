+/** Tilawati patch: builds the checker's index tables in a JSON-friendly shape (see precomputed.js). */
+import { lexicalWords } from "./checker-lexical.js";
+import { formulaSlots } from "./formula-slots.js";
+import { maddSites } from "./madd-drops.js";
+import { parallelPaths } from "./parallel-phrases.js";
+import { slotSpans } from "./slot-spans.js";
+import { INDEX_TABLES_VERSION } from "./precomputed.js";
+export function computeIndexTables(index) {
+    const lx = lexicalWords(index).tables;
+    const madd = maddSites(index);
+    return {
+        v: INDEX_TABLES_VERSION,
+        words: index.words.length,
+        phonemes: index.phonemes.length,
+        parallel: [...parallelPaths(index)],
+        formula: [...formulaSlots(index)],
+        spans: slotSpans(index),
+        madd: { munfasil: [...madd.munfasil], drops: [...madd.drops] },
+        lexical: {
+            forms: lx.forms,
+            isolated: [...lx.isolated],
+            connected: [...lx.connected].map(([k, v]) => [k, [...v]]),
+            rawByForm: [...lx.rawByForm],
+            byStem: [...lx.byStem],
+            wordNorms: lx.wordNorms,
+            bySkel: [...lx.bySkel],
+        },
+    };
+}
