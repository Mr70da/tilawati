@@ -0,0 +1,16 @@
+/**
+ * Tilawati patch: index tables computed ahead of time (scripts/precompute-engine.mjs) for one reference.
+ * The builders (lexicalWords, parallelPaths, maddSites, formulaSlots, slotSpans) use them instead of rebuilding,
+ * which takes seconds in Hermes. Tables only apply to an index of the same shape; otherwise everything is built
+ * as before.
+ */
+let tables = null;
+export const INDEX_TABLES_VERSION = 2;
+export function setPrecomputedIndexes(t) {
+    tables = t && t.v === INDEX_TABLES_VERSION ? t : null;
+}
+export function precomputed(index, key) {
+    if (!tables || tables.words !== index.words.length || tables.phonemes !== index.phonemes.length)
+        return null;
+    return tables[key] ?? null;
+}
